{
    "MongoDbSettings": {
        
        "DatabaseName": "OnlineShopDb"
    },

    "JwtSettings": {
        "Issuer": "Shop.API",
        "Audience": "Shop.Client",
        "ExpirationMinutes": 60
    },


    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "ZarinPal": {
        "MerchantId": "YOUR-MERCHANT-ID",
        "CallbackUrl": "https://localhost:7111/api/Payments/callback",
        "WalletTopUpCallbackUrl": "https://localhost:7111/api/WalletTopUp/callback",
        "Sandbox": true
    },

    "AllowedHosts": "*"
}